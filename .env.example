# Firebase Client SDK (NEXT_PUBLIC_ prefix makes these available to client-side code)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK (server-side only — JSON string of service account key)
FIREBASE_SERVICE_ACCOUNT_KEY=

# Session cookie signing secret (REQUIRED — generate with: openssl rand -hex 32)
COOKIE_SECRET=

# Base URL (used for OAuth redirects)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Notion integration
NOTION_API_KEY=
NOTION_FEEDBACK_DB_ID=
NOTION_SUPPORT_DB_ID=
NOTION_BETA_DB_ID=

# AI / Genkit
GOOGLE_GENAI_API_KEY=

# LinkedIn OAuth
NEXT_PUBLIC_LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=

# Email (SMTP for notifications)
SMTP_EMAIL=
SMTP_PASSWORD=

# Cron security
CRON_SECRET=

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Pipeline media: TL can write to their own folder only
    // Read requires auth (URLs are token-protected by default)
    match /pipeline/{tlId}/{postId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == tlId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*|application/pdf');
    }

    // User uploads (support, feedback, posts) — user can only write to their own folder
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024;
    }

    // Company logos/assets — any authenticated user in the company can read
    // Write: admin uploads logo via client SDK using companies/{companyId}/... path
    // We can't check companyId membership in Storage rules without custom claims
    // So we allow write for authenticated users but rely on path structure
    // (only admins have UI to upload here, and the companyId matches their own)
    match /companies/{companyId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*|video/.*|application/pdf');
    }
  }
}

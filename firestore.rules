rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user has a specific role
    function hasRole(userId, role) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role == role;
    }

    // Helper function to get the user's company ID
    function getCompanyId(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.companyId;
    }

    // Fields that only server actions can modify (never client)
    function isNotChangingProtectedFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'companyId', 'companyName', 'points']);
    }

    // Prevent excessively large documents (max 20 fields at root level)
    function isReasonableSize() {
      return request.resource.data.keys().size() <= 30;
    }

    // Validate string field is not absurdly long (max 10KB)
    function isReasonableString(field) {
      return field is string && field.size() <= 10000;
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Only server actions create users (via Admin SDK, which bypasses rules)
      allow create: if false;

      // A user can read their own document.
      // An admin can read documents of users in their own company.
      // A master admin can read any user document.
      allow read: if request.auth.uid == userId
                  || (hasRole(request.auth.uid, 'admin') && getCompanyId(request.auth.uid) == resource.data.companyId)
                  || hasRole(request.auth.uid, 'master');

      // A user can update their own profile and personal branding data,
      // but CANNOT change role, companyId, or companyName.
      allow update: if request.auth.uid == userId
                    && isNotChangingProtectedFields()
                    && isReasonableSize();

      // Rules for user subcollections (trailProgress, etc.)
      match /trailProgress/{trailId} {
        // User can read their own progress
        allow read: if request.auth.uid == userId;

        // User can create initial progress (pontosGanhos must be 0)
        allow create: if request.auth.uid == userId
                      && request.resource.data.pontosGanhos == 0
                      && request.resource.data.concluida == false;

        // User can update progress but cannot set pontosGanhos > 5000 (safety cap)
        // Full point calculation is done server-side via recalculatePoints
        allow update: if request.auth.uid == userId
                      && request.resource.data.pontosGanhos is number
                      && request.resource.data.pontosGanhos >= 0
                      && request.resource.data.pontosGanhos <= 5000;

        // Admin can read progress of users in their company
        allow read: if hasRole(request.auth.uid, 'admin')
                    && getCompanyId(request.auth.uid) == getCompanyId(userId);

        // Master can read any progress
        allow read: if hasRole(request.auth.uid, 'master');
      }

      // Rescues (reward redemptions) — created by server action redeemReward (Admin SDK)
      match /rescues/{rescueId} {
        allow read: if request.auth.uid == userId;
      }

      // Points history — trail completions from client, missions from server (Admin SDK)
      match /pointsHistory/{historyId} {
        allow read: if request.auth.uid == userId;

        // Allow client to create trail completion entries (capped at 5000 points)
        allow create: if request.auth.uid == userId
                      && request.resource.data.type == 'gain'
                      && request.resource.data.source == 'trilha'
                      && request.resource.data.points is number
                      && request.resource.data.points >= 0
                      && request.resource.data.points <= 5000;

        // Admin can read points history of users in their company
        allow read: if hasRole(request.auth.uid, 'admin')
                    && getCompanyId(request.auth.uid) == getCompanyId(userId);

        // Master can read any points history
        allow read: if hasRole(request.auth.uid, 'master');
      }

      // Generated content from AI assistant
      match /generatedContent/{contentId} {
        allow read, delete: if request.auth.uid == userId;
      }

      // Scheduled posts for LinkedIn — user can only access their own posts
      // All writes go through server actions (Admin SDK), but allow client reads
      match /scheduledPosts/{postId} {
        allow read: if request.auth.uid == userId;
      }
    }

    // Rules for the 'companies' collection
    match /companies/{companyId} {
      // Only server actions create companies (via Admin SDK)
      allow create: if false;

      // Admins and colaboradores can read their own company's data.
      // Master admins can read any company's data.
      allow read: if request.auth != null
                  && (getCompanyId(request.auth.uid) == companyId || hasRole(request.auth.uid, 'master'));

      // Only admins of the company or master admins can update company data.
      allow update: if request.auth != null
                   && ( (hasRole(request.auth.uid, 'admin') && getCompanyId(request.auth.uid) == companyId) || hasRole(request.auth.uid, 'master') );

      // Only server actions can delete companies (via Admin SDK)
      allow delete: if false;

      // Rules for company subcollections (sessions, activatedGlobalTrails, assets, etc.)
      match /{subcollection}/{docId} {
        // Admins of the company and master admins can manage all subcollections
        allow read: if request.auth != null
                    && ( (hasRole(request.auth.uid, 'admin') && getCompanyId(request.auth.uid) == companyId) || hasRole(request.auth.uid, 'master') );

        allow write: if request.auth != null
                     && ( (hasRole(request.auth.uid, 'admin') && getCompanyId(request.auth.uid) == companyId) || hasRole(request.auth.uid, 'master') )
                     && isReasonableSize();

        // Colaboradores can only read specific subcollections they need
        allow read: if request.auth != null
                    && hasRole(request.auth.uid, 'colaborador')
                    && getCompanyId(request.auth.uid) == companyId
                    && subcollection in ['missions', 'missionSubmissions', 'trails', 'rewards', 'rescues', 'assets', 'library', 'activatedGlobalTrails'];

        // Deep subcollections (e.g., sessions/{id}/trails/{id})
        match /{deepSub}/{deepDocId} {
          allow read: if request.auth != null
                      && ( (hasRole(request.auth.uid, 'admin') && getCompanyId(request.auth.uid) == companyId) || hasRole(request.auth.uid, 'master') );

          allow write: if request.auth != null
                       && ( (hasRole(request.auth.uid, 'admin') && getCompanyId(request.auth.uid) == companyId) || hasRole(request.auth.uid, 'master') )
                       && isReasonableSize();

          // Colaboradores: only read deep subs of allowed parent subcollections
          allow read: if request.auth != null
                      && hasRole(request.auth.uid, 'colaborador')
                      && getCompanyId(request.auth.uid) == companyId
                      && subcollection in ['missions', 'missionSubmissions', 'trails', 'rewards', 'rescues', 'assets', 'library', 'activatedGlobalTrails'];
        }
      }
    }

    // Rules for global sessions (master-managed, read by all authenticated users)
    match /globalSessions/{sessionId} {
      // Only master can write global sessions
      allow read: if request.auth != null;
      allow write: if hasRole(request.auth.uid, 'master');

      // Trails within global sessions
      match /trails/{trailId} {
        allow read: if request.auth != null;
        allow write: if hasRole(request.auth.uid, 'master');
      }
    }
  }
}
